// Copy to Local.xcconfig (untracked) to override the identity of Debug builds.
// Release builds never read it; for a one-off local Release build, pass it
// explicitly: xcodebuild -xcconfig Configs/Local.xcconfig ...
// Your Apple Developer Team ID - https://stackoverflow.com/a/18727947
DEVELOPMENT_TEAM = ABC123

// Bundle and App Group ids are unique across all Apple teams. Outside the
// Wesh team, replace both with ids registered to your own team.
PRODUCT_BUNDLE_IDENTIFIER = org.samouraiworld.wesh.ios.dev

// App and share extension must use an App Group registered to your team.
APP_GROUP_ID = group.org.samouraiworld.wesh.dev
