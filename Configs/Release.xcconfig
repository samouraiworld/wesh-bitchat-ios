MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 108

IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0

// Wesh release identity (Samouraï Coop). The share extension appends
// ".ShareExtension" to the bundle ID; entitlements read APP_GROUP_ID.
DEVELOPMENT_TEAM = UF5852SF57
CODE_SIGN_STYLE = Automatic

PRODUCT_BUNDLE_IDENTIFIER = org.samouraiworld.wesh.ios
APP_GROUP_ID = group.org.samouraiworld.wesh.ios

// The release candidate offers the Internet opt-in: Info.plist WeshInternetAvailable shows
// the switch, while the mode stays off until the disclosure is accepted and
// the user turns it on.
WESH_INTERNET_AVAILABLE = YES

// No Local.xcconfig here: a Release build, and every archive sent to App
// Store Connect, resolves from tracked settings only. Debug.xcconfig reads
// the developer-local override; scripts/check_release_local_override.py
// guards this in CI.
