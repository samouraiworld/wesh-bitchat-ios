MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 101

IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0

// Wesh release identity (Samouraï Coop). The share extension appends
// ".ShareExtension" to the bundle ID; entitlements read APP_GROUP_ID.
DEVELOPMENT_TEAM = UF5852SF57
CODE_SIGN_STYLE = Automatic

PRODUCT_BUNDLE_IDENTIFIER = org.samouraiworld.wesh.ios
APP_GROUP_ID = group.org.samouraiworld.wesh.ios

// Beta 2 ships without Internet mode: Info.plist WeshInternetAvailable hides
// the switch and keeps the mode off. Debug keeps it for tests.
WESH_INTERNET_AVAILABLE = NO

// Optional developer-local override (for example the internal .dev
// identity), shared by build and archive. It stays untracked.
#include? "Local.xcconfig"
