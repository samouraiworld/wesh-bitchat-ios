        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "đã gửi %@ — cashu là token theo người cầm giữ; ai đổi trước sẽ nhận được tiền"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发送 %@ — cashu 是不记名代币，谁先兑换资金就归谁"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已送出 %@ — cashu 是不記名代幣，誰先兌換錢就是誰的"
          }
        }
      }
    },
