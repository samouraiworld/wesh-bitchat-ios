        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gönderildi — cashu hamiline yazılı bir token; kim önce bozdurursa parayı o alır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "надіслано %@ — cashu — це токен на пред'явника; кошти отримає той, хто першим його погасить"
