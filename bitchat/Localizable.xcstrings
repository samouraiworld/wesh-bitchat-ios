    "command.pay.invalid" : {
      "comment" : "Error when /pay input fails to decode",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز cashu غير صالح — لا يمكن فك ترميزه إلى رمز معروف بمبلغ، لن يتم إرساله"
          }
        },
        "bn" : {
          "stringUnit" : {
