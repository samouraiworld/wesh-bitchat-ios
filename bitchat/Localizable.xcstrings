        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ بھیج دیا گیا — cashu ایک bearer ٹوکن ہے؛ جو پہلے اسے ریڈیم کرے گا رقم اسے ملے گی"
