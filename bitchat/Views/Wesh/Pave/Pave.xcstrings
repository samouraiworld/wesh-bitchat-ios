    "pave.report.localBlock" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking is immediate and stays on this phone: their messages are hidden. You can then send the report to the Wesh team by e-mail, if you wish; the team will see the e-mail address you use."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage est immédiat et reste sur ce téléphone : ses messages sont masqués. Vous pourrez ensuite, si vous le souhaitez, envoyer le signalement à l’équipe Wesh par e-mail ; l’équipe verra l’adresse e-mail utilisée."
          }
        }
      }
    },
