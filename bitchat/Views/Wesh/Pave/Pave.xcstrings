    "pave.report.send.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Pick a reason: your mail app opens a draft with the nickname shown, the fingerprint and the reason, plus the message for a public room message. No private message is added. You can edit it before sending; nothing leaves without you. The team will see your e-mail address."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Choisissez un motif : votre application mail ouvre un brouillon avec le surnom affiché, l’empreinte et le motif, plus le message s’il s’agit du salon public. Aucun message privé n’est ajouté. Vous pouvez le modifier avant l’envoi ; rien ne part sans vous. L’équipe verra votre adresse e-mail."
          }
        }
      }
    },
