    "pave.localErase.failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacement local à terminer : des données peuvent rester sur ce téléphone. Réessayez maintenant ; sinon Wesh recommencera au prochain lancement, avant de se connecter. D’ici là, Bluetooth et Internet restent coupés."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local erasure not finished: some data may remain on this phone. Retry now; otherwise Wesh will try again the next time it starts, before connecting. Until then, Bluetooth and Internet stay off."
          }
        }
      }
    },
    "pave.localErase.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action efface l’identité Wesh, les contacts et leurs vérifications, l’historique, les fichiers reçus, les brouillons et la note de rendez-vous conservés ici. Elle ne supprime pas les copies détenues par d’autres personnes ni leurs sauvegardes. Elle ne garantit pas un effacement physique du stockage. Cette action est irréversible."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This erases the Wesh identity, contacts and their verifications, history, received files, drafts and meeting note kept here. It does not delete copies held by other people or their backups. It does not guarantee physical erasure of storage. This action is irreversible."
          }
        }
      }
    },
